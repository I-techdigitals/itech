# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local dev:
# MONGO_URI=mongodb://127.0.0.1:27017/itech-digitals
#
# Production (Vercel — set in Dashboard → Backend service → Environment Variables):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/itech-digitals?retryWrites=true&w=majority
#
MONGO_URI=mongodb://127.0.0.1:27017/itech-digitals

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Local dev:
# FRONTEND_URL=http://localhost:3000
#
# Production (Vercel — set in Dashboard → Backend service → Environment Variables):
# FRONTEND_URL=https://itechdigitals.com
#
FRONTEND_URL=http://localhost:3000

# ─── Admin API Key ────────────────────────────────────────────────────────────
ADMIN_KEY=change-this-admin-key

# ─── SMTP email delivery. Brevo example: ──────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-key
COMPANY_EMAIL=where-bookings-go@example.com
NOTIFY_EMAIL=where-career-applications-go@example.com
BREVO_API_KEY=optional-brevo-transactional-api-key
