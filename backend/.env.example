# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend URL (CORS) ──────────────────────────────────────────────────────
# Local dev:
FRONTEND_URL=http://localhost:3000
#
# Production (Vercel backend service):
# FRONTEND_URL=https://itechdigitals.com

# ─── SMTP email (Brevo example) ───────────────────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@example.com
SMTP_PASS=your-brevo-smtp-key
# Must be a sender verified in Brevo (your real inbox — not the smtp-brevo.com login)
SMTP_FROM=business.itechdigitals@gmail.com
COMPANY_EMAIL=where-contact-leads-go@example.com
NOTIFY_EMAIL=where-career-applications-go@example.com
BREVO_API_KEY=optional-brevo-transactional-api-key
